# Flask Configuration
SECRET_KEY=change-me-use-a-long-random-secret
ADMIN_PASSWORD=set-a-strong-admin-password-here
SESSION_COOKIE_SECURE=True
APP_ENV=production

# Hosted PostgreSQL (Supabase session-pooler connection string)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=eventmate_db
MYSQL_PORT=3306

# College Details
COLLEGE_NAME=Shree Daksha Academy
COLLEGE_SUBTITLE=Department of Computer Applications (BCA / MCA)
EVENT_TITLE=Daksha Infinix
SIGNATORY_NAME=Dilip kumar 
SIGNATORY_TITLE=Head of Department & Event Convenor

# Email Configuration
# Render Free blocks SMTP ports, so use Resend over HTTPS for production email.
SMTP_MODE=demo
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=eventmate.college@gmail.com
SMTP_USE_TLS=True
SMTP_USE_SSL=False
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Payments remain in demo mode until the official UPI ID is confirmed.
# Demo mode is for preview only; do not send real money.
PAYMENT_MODE=demo

# Base URL (for QR code & verification link)
# Leave blank on Render to use its generated HTTPS URL, or set the public URL explicitly.
BASE_URL=

# Add confirmed organizer numbers before publishing direct call links.
CONTACT_PHONE_PRIMARY=
CONTACT_PHONE_SECONDARY=
