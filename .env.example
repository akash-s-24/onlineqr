# Flask Configuration
SECRET_KEY=change-me-use-a-long-random-secret
ADMIN_PASSWORD=set-a-strong-admin-password-here
SESSION_COOKIE_SECURE=True
APP_ENV=production

# Hosted PostgreSQL (Supabase session-pooler connection string)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=eventmate_db
MYSQL_PORT=3306

# College Details
COLLEGE_NAME=Shree Daksha Academy
COLLEGE_SUBTITLE=Department of Computer Applications (BCA / MCA)
EVENT_TITLE=SDA 2026 2027
SIGNATORY_NAME=Dilip kumar 
SIGNATORY_TITLE=Head of Department & Event Convenor

# SMTP Email Configuration
# Set SMTP_MODE to 'demo' for safe simulated dispatch (default), or 'live' for real Gmail SMTP
SMTP_MODE=demo
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=eventmate.college@gmail.com
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Base URL (for QR code & verification link)
BASE_URL=http://127.0.0.1:5000

# Temporary lead contact numbers for the demo site
CONTACT_PHONE_PRIMARY=+91 90000 00001
CONTACT_PHONE_SECONDARY=+91 90000 00002
